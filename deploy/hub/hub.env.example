# The team hub's settings (copy to hub.env next to compose.yaml; hub.env is not committed).
# The Slack app: create it from slack-app-manifest.yaml (Socket Mode), install it, then copy:
#   Basic Information > App-Level Tokens (connections:write)
SLACK_APP_TOKEN=xapp-...
#   OAuth & Permissions > Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-...
# The URL members enter in Pacenote (Settings > Messengers > Slack > Team hub). Upload URLs handed to desktops use it.
# https, or on a network of your own http://<the server's address>:8790.
HUB_PUBLIC_URL=https://pacenote-hub.example.com
# Members the hub starts with (comma-separated Slack user IDs): with some, it is for listed members. Each is added once;
# the hub's admins keep the list in Pacenote after that. Empty: everyone in the workspace.
HUB_ALLOWED_USERS=
# Admins whatever Pacenote says (comma-separated Slack user IDs). Empty: whoever ran the installer, or the first member.
HUB_ADMINS=
# The language of the notes the hub posts to members in Slack: en (default) or ko.
HUB_NOTES_LANGUAGE=
# Slack's Web API. Leave empty for slack.com; https://slack-gov.com/api/ for a GovSlack workspace.
SLACK_API_URL=
LOG_LEVEL=info

# Example Pacenote config file. Copy it outside the repository to ~/.pacenote/.env. (PACENOTE_HOME changes the location)
# The bot (app, terminal) and the sandbox jobs read this file. Keep values of the target environment out of the repository.

# ---- Slack (required) ----
# Bot User OAuth Token (OAuth & Permissions)
SLACK_BOT_TOKEN=xoxb-
# App-Level Token with the connections:write scope (Basic Information > App-Level Tokens)
SLACK_APP_TOKEN=xapp-
TIMEZONE=Asia/Seoul
# Socket Mode keepalive. Reconnects if a ping sent by the bot gets no reply within this time (ms),
# or if no ping arrives from Slack for this long (ms).
SOCKET_CLIENT_PING_TIMEOUT_MS=5000
SOCKET_SERVER_PING_TIMEOUT_MS=30000
# Logs ping/pong (visible with LOG_LEVEL=debug)
SOCKET_PING_PONG_LOG=off

# ---- Mentions ----
# Who may ask Pace through your own Slack app: comma-separated Slack user IDs, starting with yours
# (to find an ID: Slack profile > More > Copy member ID). The bot does not start without it, unless
# MENTION_ANYONE=on. With the team hub, each desktop answers only its own member.
MENTION_ALLOWED_USERS=
# on: anyone in your workspace may ask instead (not people from other organizations in shared channels)
MENTION_ANYONE=off
# Directory consulted read-only when answering (absolute path); the CLI reads nothing else, and never its
# .env files. Not used with codex@vm.
MENTION_WORKSPACE=
# Number of CLIs run at once. Requests beyond that wait in a queue of up to 10.
MENTION_CONCURRENCY=2

# ---- Reasoner backend ----
# claude: claude -p, codex: codex exec. Both use the local CLI's login.
REASONER=claude
# Empty: claude-opus-5-5 for claude, the model in ~/.codex/config.toml for codex
REASONER_MODEL=
REASONER_TIMEOUT_SEC=300
CLAUDE_BIN=claude
CODEX_BIN=codex

# ---- Reasoner sandbox ----
# vm: run the CLI in a lightweight Linux VM of its own per request, built in (Apple silicon, macOS 15 or later;
#     needs pnpm sandbox:vm)
# none: run directly on the host
REASONER_SANDBOX=vm
# The VM has no host keychain, so claude credentials are passed separately. (one of the two)
# Subscription token issued with claude setup-token
SANDBOX_CLAUDE_OAUTH_TOKEN=
SANDBOX_ANTHROPIC_API_KEY=
# codex: the login file is mounted read-only.
SANDBOX_CODEX_AUTH_FILE=~/.codex/auth.json
SANDBOX_MEMORY=2g
SANDBOX_CPUS=2

# ---- Ops tools (ops-broker) ----
# on: attaches ops-broker (MCP) to the reasoner CLI. SSH host checks, k8s queries, work directory reads (read-only),
# code changes and draft PRs in a separate workspace.
# Needs the built-in sandbox (REASONER_SANDBOX=vm) and MENTION_ALLOWED_USERS, with MENTION_ANYONE off.
# pnpm sandbox:vm builds the broker's image; the broker starts in a VM of its own with Pace and applies these then.
# The values below are optional per feature. The broker starts without the tools of any feature left empty.
OPS_TOOLS=off
# Work directory (fs_*, ws_*). Mounted read-only. Absolute path
OPS_FS_ROOT=
# Orgs allowed for code changes/PRs and GitHub queries (ws_*, gh_*). Comma-separated
# The broker gets the token from gh auth token when it starts.
OPS_GIT_ALLOWED_OWNERS=
# Author of commits the sandbox makes. Leave empty to use the global git config (git config --global).
# Separate from this repository's git config (local user.name/email).
OPS_GIT_AUTHOR_NAME=
OPS_GIT_AUTHOR_EMAIL=
# Jira queries, issue creation, comments (jira_*). On only when all four are set. Issues and comments are made as
# the token owner's account, and statuses are never changed. Token: id.atlassian.com > Security > API tokens
OPS_JIRA_URL=
OPS_JIRA_EMAIL=
OPS_JIRA_TOKEN=
# Allowed project keys, comma-separated
OPS_JIRA_PROJECTS=
# k8s queries (k8s_*). Local kubeconfig contexts, comma-separated. pnpm k8s:kubeconfig builds
# the broker kubeconfig from each cluster's read-only ServiceAccount token. (sandbox/k8s/pacenote-ro.yaml)
OPS_K8S_CONTEXTS=
OPS_K8S_SA=pacenote-ro
OPS_K8S_SA_NAMESPACE=pacenote
# Host SSH checks (host_*). On only when the user, allowed range and key are all set. Paths are absolute
OPS_SSH_USER=
OPS_SSH_ALLOWED_CIDR=
OPS_SSH_KEY=
# Empty: host keys from the first connection are remembered only inside the broker.
OPS_SSH_KNOWN_HOSTS=
# Host list: when the broker starts (with Pace), the ansible inventory is rendered into
# ~/.pacenote/ops-broker/hosts.json.
# Empty: write ~/.pacenote/ops-broker/hosts.json ({ "web-01": "192.168.10.11" }) directly. A relative inventory directory path is relative to this repository
OPS_SSH_INVENTORY_DIR=
OPS_SSH_INVENTORY=

# ---- Diagrams ----
# Renders mermaid/dot/vega-lite/svg blocks in answers as PNG in a VM with no network and uploads them. (files:write)
# Needs the built-in sandbox set up (pnpm sandbox:vm builds the renderer's image), whatever REASONER_SANDBOX is.
RENDER_DIAGRAMS=on
# Shrinks the long side of codex generated images to this size before upload. 0 keeps the original
GENERATED_IMAGE_MAX_PX=512

# ---- Run history, status, logs ----
# Run history (runs/), bot status (bot.json) and logs (logs/bot.log) are kept in PACENOTE_DATA_DIR. View them in the desktop app (pnpm desktop).
PACENOTE_DATA_DIR=~/.pacenote
HISTORY=on
# Older records are deleted. 0 keeps them forever.
HISTORY_RETENTION_DAYS=30

LOG_LEVEL=info
